# Google OAuth 2.0 credentials (Web application type)
# Create at: console.cloud.google.com > APIs & Services > Credentials
# Client secret is intentionally included — personal single-user app, no backend.
# It will be visible in the built JS bundle, which is an acceptable tradeoff here.
VITE_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your_client_secret_here
